<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RuneStorage</AssemblyName>
    <RootNamespace>RuneStorage</RootNamespace>
    <Version>0.1.11</Version>
    <OutputPath>bin/Release/net48/</OutputPath>
    <GeneratePathProperty>true</GeneratePathProperty>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Valheim install folder. Override with -p:ValheimDir="..." if the game is installed elsewhere. -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimManagedDir>$(ValheimDir)\valheim_Data\Managed</ValheimManagedDir>
    <!-- BepInEx, 0Harmony, and Jotunn are vendored under lib/BepInEx (see lib/BepInEx/VENDORED.txt). -->
    <RuneStorageBepInExLibDir>$(MSBuildThisFileDirectory)..\..\lib\BepInEx</RuneStorageBepInExLibDir>
  </PropertyGroup>

  <Target Name="CheckRuneStorageReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)\assembly_valheim.dll')"
           Text="Valheim managed assemblies not found at '$(ValheimManagedDir)'. Pass -p:ValheimDir=&quot;C:\path\to\Valheim&quot;." />
    <Error Condition="!Exists('$(RuneStorageBepInExLibDir)\BepInEx.dll')"
           Text="Vendored BepInEx not found at '$(RuneStorageBepInExLibDir)'." />
  </Target>

  <!-- Gale/r2modman RuneStorage Test profile. Built DLLs are copied here automatically when the profile exists. -->
  <PropertyGroup>
    <RuneStorageTestProfileDir Condition="'$(RuneStorageTestProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\RuneStorage Test</RuneStorageTestProfileDir>
  </PropertyGroup>

  <Target Name="DeployToRuneStorageTestProfile" AfterTargets="Build" Condition="Exists('$(RuneStorageTestProfileDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RuneStorageTestProfileDir)\BepInEx\plugins" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(RuneStorageTestProfileDir)\BepInEx\plugins" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(RuneStorageBepInExLibDir)\BepInEx.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(RuneStorageBepInExLibDir)\Jotunn.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(RuneStorageBepInExLibDir)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AssetBundles\runestorage_terminal" />
    <EmbeddedResource Include="Assets\AssetBundles\runestorage_core" />
  </ItemGroup>
</Project>
